# Local development configuration. Loaded by `make run` and by docker-compose.yml.
#
# Everything here is for a laptop only. The database password is a throwaway
# value used by the local Postgres container and is not a secret.
# Format: KEY=VALUE, no quotes, no $ (see internal/config/envfile.go).

APP_ENV=local
APP_SERVICE_NAME=platform-backend
HTTP_ADDR=:8080
LOG_LEVEL=debug
LOG_FORMAT=text

# The host port of the Compose Postgres. Inside Compose, docker-compose.yml
# overrides this to reach the `postgres` service instead.
DATABASE_URL=postgres://platform:local-only-password@localhost:5433/platform_local?sslmode=disable
DATABASE_MAX_CONNS=5
