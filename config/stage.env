# stage configuration: NON-SECRET values only.
#
# Secrets are never committed. At deploy time they are read from AWS Secrets
# Manager (region eu-central-1) and injected as environment variables:
#
#   DATABASE_URL  <-  secret "stage/platform-backend/database-url"
#                     must point at a database named platform_stage
#                     and use sslmode=verify-full
#
# internal/config/config_test.go fails if a secret-looking key appears here.

APP_ENV=stage
APP_SERVICE_NAME=platform-backend
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=json
DATABASE_MAX_CONNS=10
DATABASE_CONNECT_TIMEOUT=5s
HTTP_SHUTDOWN_TIMEOUT=20s
